# Frontend local dev (put in frontend/.env or export before `npm run dev`)
VITE_API_URL=http://127.0.0.1:8787

# ---------------------------------------------------------------------------
# Worker secrets (do NOT put here — set via `wrangler secret put NAME`):
#   ANTHROPIC_API_KEY
#   OPENAI_API_KEY
#   GOOGLE_API_KEY
#   UPSTASH_REDIS_REST_URL   (optional)
#   UPSTASH_REDIS_REST_TOKEN (optional)
#
# Worker public vars go in worker/wrangler.toml under [vars]:
#   CORS_ORIGIN
#   INSPECTION_INTERVAL_MS
# ---------------------------------------------------------------------------
