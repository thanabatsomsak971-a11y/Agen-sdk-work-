# --- Ports ---
BACKEND_PORT=3001
FRONTEND_PORT=5173

# --- Databases (used by docker-compose service names) ---
MONGO_URL=mongodb://mongo:27017/s_agens
REDIS_URL=redis://redis:6379

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- AI providers (leave blank until you have keys) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Inspection defaults ---
INSPECTION_INTERVAL_MS=5000
