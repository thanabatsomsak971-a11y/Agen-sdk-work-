{
  "name": "s-agens-worker",
  "version": "0.1.0",
  "private": true,
  "description": "S-AGENS Cloudflare Worker — inspection & reporting API",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:create": "wrangler d1 create s-agens-db",
    "db:migrate:local": "wrangler d1 migrations apply s-agens-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply s-agens-db --remote",
    "db:studio": "drizzle-kit studio",
    "types": "wrangler types"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@upstash/redis": "^1.34.0",
    "drizzle-orm": "^0.33.0",
    "hono": "^4.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "drizzle-kit": "^0.24.2",
    "typescript": "^5.5.4",
    "wrangler": "^3.78.0"
  }
}
